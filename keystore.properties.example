# Copy to keystore.properties and fill in. That file is gitignored — never commit it.
# Generate the keystore with:
#   keytool -genkeypair -v -keystore pyblock-watch-release.jks \
#     -alias pyblockwatch -keyalg RSA -keysize 4096 -validity 10000
storeFile=../pyblock-watch-release.jks
storePassword=CHANGEME
keyAlias=pyblockwatch
keyPassword=CHANGEME
